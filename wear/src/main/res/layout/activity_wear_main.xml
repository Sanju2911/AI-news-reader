<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Full-screen background image -->
    <ImageView
        android:id="@+id/bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_controls_page"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"/>

    <!-- Full-screen dark overlay for readability -->
    <View
        android:id="@+id/bg_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"/>

    <ViewFlipper
        android:id="@+id/view_flipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:inAnimation="@android:anim/fade_in"
        android:outAnimation="@android:anim/fade_out">

        <!-- ═══ Page 0: Media Player (Full-screen) ═══ -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false">

            <!-- ── Top area: Title + Subtitle ── -->
            <LinearLayout
                android:id="@+id/top_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingHorizontal="30dp">

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Loading news..."
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="marquee"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:singleLine="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:fontFamily="sans-serif-medium"/>

                <TextView
                    android:id="@+id/tv_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="World · 1/10"
                    android:textColor="#E07A3A"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"/>
            </LinearLayout>

            <!-- ── Center: Play button with circular progress ring ── -->
            <FrameLayout
                android:id="@+id/play_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true">

                <ProgressBar
                    android:id="@+id/progress_arc"
                    style="?android:progressBarStyleHorizontal"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_gravity="center"
                    android:max="100"
                    android:progress="0"
                    android:indeterminate="false"
                    android:progressDrawable="@drawable/circular_progress"
                    android:rotation="-90"/>

                <ImageButton
                    android:id="@+id/btn_play_pause"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_media_play"
                    android:background="@drawable/bg_play_main"
                    android:tint="#1A1A1A"
                    android:scaleType="centerInside"
                    android:padding="10dp"
                    android:contentDescription="Play Pause"/>
            </FrameLayout>

            <!-- Previous button -->
            <ImageButton
                android:id="@+id/btn_prev"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/play_container"
                android:layout_marginEnd="2dp"
                android:src="@android:drawable/ic_media_previous"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:tint="#FFFFFF"
                android:scaleType="centerInside"
                android:padding="10dp"
                android:contentDescription="Previous"/>

            <!-- Next button -->
            <ImageButton
                android:id="@+id/btn_next"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/play_container"
                android:layout_marginStart="2dp"
                android:src="@android:drawable/ic_media_next"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:tint="#FFFFFF"
                android:scaleType="centerInside"
                android:padding="10dp"
                android:contentDescription="Next"/>

            <!-- ── Bottom row: Topics | Volume ── -->
            <LinearLayout
                android:id="@+id/bottom_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_alignParentBottom="true"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/btn_topics"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_menu_sort_by_size"
                    android:background="@drawable/bg_circle_small"
                    android:tint="#CCCCCC"
                    android:scaleType="centerInside"
                    android:padding="8dp"
                    android:contentDescription="Topics"/>

                <ImageButton
                    android:id="@+id/btn_volume"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="20dp"
                    android:src="@android:drawable/ic_lock_silent_mode_off"
                    android:background="@drawable/bg_circle_small"
                    android:tint="#CCCCCC"
                    android:scaleType="centerInside"
                    android:padding="8dp"
                    android:contentDescription="Volume"/>

            </LinearLayout>

        </RelativeLayout>

        <!-- ═══ Page 1: Topics List (Full-screen) ═══ -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000"
            android:scrollbars="none"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:paddingTop="28dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:id="@+id/topics_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"/>

        </ScrollView>

        <!-- ═══ Page 2: Volume Control (Full-screen) ═══ -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000">

            <!-- Circular volume slider -->
            <com.newsreader.wear.CircularVolumeSlider
                android:id="@+id/volume_slider"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_gravity="center"/>

            <!-- Center: volume icon + level -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@android:drawable/ic_lock_silent_mode_off"
                    android:tint="#FFFFFF"
                    android:scaleType="centerInside"/>

                <TextView
                    android:id="@+id/tv_volume_level"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="7"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"/>

            </LinearLayout>

        </FrameLayout>

    </ViewFlipper>
</FrameLayout>
